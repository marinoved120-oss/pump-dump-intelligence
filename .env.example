BINANCE_FUTURES_BASE_URL=https://fapi.binance.com
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=5

# Controlled development orchestrator.
# Use a separate Telegram bot from the market-monitoring bot.
TELEGRAM_DEV_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
TELEGRAM_DEV_CHAT_ID=

# Required only when autonomous code generation is enabled.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

PROJECT_ROOT=/workspace
ORCHESTRATOR_STATE_DIR=/workspace/orchestrator_state
ORCHESTRATOR_WORKER_ENABLED=false
ORCHESTRATOR_AUTO_MERGE_LOW_RISK=false
ORCHESTRATOR_TEST_COMMAND=python -m pytest
ORCHESTRATOR_GIT_USER_NAME=PumpDump Orchestrator
ORCHESTRATOR_GIT_USER_EMAIL=orchestrator@localhost
